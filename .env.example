PG_PORT=5432
PG_NAME=life_balance_db
PG_ROOT_USER=postgres
PG_ROOT_PASS=postgres_pass
PG_LB_USER=app_user
PG_LB_PASS=app_pass
PG_AUTH_USER=auth_app_user
PG_AUTH_PASS=auth_app_pass
PG_HOST=localhost

AUTH_PORT=8080
AUTH_REALM=luppol
AUTH_ADMIN=admin
AUTH_ADMIN_PASSWORD=admin

AUTH_BASE_URL=http://localhost:8080    # dev default; prod: https://auth.example.com
AUTH_HOSTNAME_STRICT=false             # prod: true (pins redirects/cookies to AUTH_BASE_URL)
AUTH_START_CMD=start-dev               # prod: start
AUTH_PROXY_MODE=edge                   # keep if behind reverse proxy; otherwise omit/change
AUTH_HTTP_ENABLED=true                 # dev true; prod per TLS topology

LB_PORT=3000
LB_CLIENT_ID=life-balance
LB_CLIENT_SECRET=dev-secret            # dev only; use secret store in prod
LB_REDIRECT_1=http://localhost:3000/*  # make these concrete (no ${LB_PORT} in .env)
LB_REDIRECT_2=http://127.0.0.1:3000/*
