PG_PORT=5432
PG_NAME=life_balance_db
PG_ROOT_USER=postgres
PG_ROOT_PASS=postgres_pass
PG_LB_USER=app_user
PG_LB_PASS=app_pass
PG_AUTH_USER=auth_app_user
PG_AUTH_PASS=auth_app_pass
PG_HOST=localhost

AUTH_PORT=8080
AUTH_REALM=luppol
AUTH_ADMIN=admin
AUTH_ADMIN_PASSWORD=admin

AUTH_BASE_URL=http://localhost:8080
AUTH_HOSTNAME_STRICT=false
AUTH_START_CMD=start-dev
AUTH_PROXY_MODE=edge
AUTH_HTTP_ENABLED=true

LB_PORT=3000
LB_CLIENT_ID=life-balance
LB_CLIENT_SECRET=dev-secret
LB_REDIRECT_1=http://localhost:3000/*
LB_REDIRECT_2=http://127.0.0.1:3000/*

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=my-smtp-user
SMTP_PASS=my-smtp-pass
SMTP_FROM=my-smtp-user
SMTP_FROM_NAME='Life Balance Auth'
SMTP_REPLY_TO=support-email
SMTP_REPLY_TO_NAME=Support
